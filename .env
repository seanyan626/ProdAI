# --- OpenAI ---
OPENAI_API_KEY="YOUR_OPENAI_KEY_HERE"
# 如果您使用代理或自定义端点，请设置此项
OPENAI_API_BASE="https://api.openai.com/v1"

# --- OpenAI Embedding ---
OPENAI_EMBEDDING_MODEL_API_KEY="YOUR_OPENAI_KEY_HERE"
OPENAI_EMBEDDING_NAME="text-embedding-ada-002"
OPENAI_EMBEDDING_API_URL="https://api.openai.com/v1"

# --- DashScope (阿里百炼 Qwen) ---
DASHSCOPE_LLM_MODEL_NAME="qwen-plus"
DASHSCOPE_EMBEDDING_NAME="text-embedding-v1"
DASHSCOPE_OCR_NAME="qwen-vl-max"
DASHSCOPE_API_KEY="sk-9cccfeedc64a45d1b44144cb4e55b49c"
DASHSCOPE_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# --- DeepSeek ---
DEEPSEEK_MODEL_NAME="deepseek-chat"
DEEPSEEK_API_KEY="sk-23bf2dd235694bd49e8f34acf11868a1"
DEEPSEEK_API_URL="https://api.deepseek.com/v1"



# --- 其他服务配置 (例如 Pinecone for RAG) ---
# PINECONE_API_KEY="YOUR_PINECONE_API_KEY"
# PINECONE_ENVIRONMENT="YOUR_PINECONE_ENVIRONMENT"

# --- OCR 云服务配置 ---
ALIYUN_OCR_API_KEY="your_aliyun_ocr_api_key_here"
BAIDU_OCR_API_KEY="your_baidu_ocr_api_key_here"
BAIDU_OCR_SECRET_KEY="your_baidu_ocr_secret_key_here"
TENCENT_OCR_SECRET_ID="your_tencent_ocr_secret_id_here"
TENCENT_OCR_SECRET_KEY="your_tencent_ocr_secret_key_here"
GOOGLE_VISION_API_KEY="your_google_vision_api_key_here"
AZURE_VISION_API_KEY="your_azure_vision_api_key_here"
AZURE_VISION_ENDPOINT="your_azure_vision_endpoint_here"

# --- OCR 基础设置 ---
DEFAULT_OCR_MODEL="paddle"
OCR_TIMEOUT=30
OCR_MAX_RETRIES=3

# --- 通用模型和应用设置 ---
# 默认使用的LLM模型名称
DEFAULT_LLM_MODEL="gpt-3.5-turbo"
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
# Agent 最大迭代次数
MAX_ITERATIONS=10
